---
export interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  align?: 'start' | 'center';
  as?: 'h1' | 'h2';
}

const { eyebrow, title, lead, align = 'start', as: Heading = 'h2' } = Astro.props;
---

<div class:list={['section-heading', `section-heading--${align}`]} data-reveal>
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <Heading class="section-heading__title" set:html={title} />
  {lead && <p class="lead">{lead}</p>}
</div>

<style>
  .section-heading {
    display: grid;
    gap: var(--space-md);
    margin-bottom: var(--space-xl);
  }

  .section-heading--center {
    justify-items: center;
    text-align: center;
  }

  .section-heading__title {
    font-size: var(--fs-3xl);
    max-width: 20ch;
  }

  .section-heading__title :global(em) {
    font-style: normal;
    color: var(--c-muted);
  }
</style>
