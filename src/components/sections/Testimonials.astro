---
/**
 * Rotating testimonial wall: two rows of real client quotes and Google
 * reviews scrolling in opposite directions (pauses on hover/focus).
 */
import { Image } from 'astro:assets';
import Icon from '@/components/ui/Icon.astro';
import { testimonials, type Testimonial } from '@/data/testimonials';

const half = Math.ceil(testimonials.length / 2);
const rows: Testimonial[][] = [testimonials.slice(0, half), testimonials.slice(half)];
const initials = (name: string) =>
  name
    .split(/\s|&/)
    .filter(Boolean)
    .map((part) => part[0])
    .slice(0, 2)
    .join('')
    .toUpperCase();
---

<section class="reviews" aria-labelledby="testimonials-title">
  <div class="reviews__head container">
    <h2 id="testimonials-title" class="reviews__title">See why venues love <span>working with us</span></h2>
    <ul role="list" class="reviews__badges">
      <li><Icon name="check" size={16} /> Hospitality-only specialists</li>
      <li><Icon name="chart" size={16} /> Results published in real case studies</li>
    </ul>
  </div>

  {
    rows.map((row, r) => (
      <div class:list={['reviews__row', { 'reviews__row--reverse': r === 1 }]}>
        <ul role="list" class="reviews__track">
          {[...row, ...row].map((t, i) => {
            const hidden = i >= row.length;
            return (
              <li class="review" aria-hidden={hidden ? 'true' : undefined}>
                <figure>
                  {t.source === 'google' && (
                    <p class="review__stars" aria-label={hidden ? undefined : '5 out of 5 stars on Google'}>
                      ★★★★★
                    </p>
                  )}
                  <blockquote class="review__quote">
                    <p>“{t.quote}”</p>
                  </blockquote>
                  <figcaption class="review__author">
                    {t.avatar ? (
                      <Image src={t.avatar} alt="" width={96} height={96} format="webp" class="review__avatar" />
                    ) : (
                      <span class="review__avatar review__avatar--initials" aria-hidden="true">
                        {initials(t.name)}
                      </span>
                    )}
                    <span>
                      <strong>{t.name}</strong>
                      <span class="review__detail">
                        {t.caseStudy && !hidden ? (
                          <a href={`/case-studies/${t.caseStudy}/`}>{t.detail}</a>
                        ) : (
                          t.detail
                        )}
                      </span>
                    </span>
                  </figcaption>
                </figure>
              </li>
            );
          })}
        </ul>
      </div>
    ))
  }

  <p class="reviews__note container">
    Google reviews are of our sister brand, SEO for Restaurants. Client quotes are from our case studies.
  </p>
</section>

<style>
  .reviews {
    margin: 0.5rem;
    padding-block: var(--space-2xl);
    border-radius: var(--radius-xl);
    background:
      radial-gradient(60% 50% at 85% 0%, rgb(215 247 91 / 0.45), transparent 70%),
      linear-gradient(160deg, var(--c-sky-700), var(--c-sky) 55%, var(--c-sky-300));
    color: var(--c-paper);
    overflow: hidden;
  }

  .reviews__head {
    display: grid;
    justify-items: center;
    gap: var(--space-lg);
    margin-bottom: var(--space-xl);
    text-align: center;
  }

  .reviews__title {
    max-width: 16ch;
    font-size: var(--fs-4xl);
    font-weight: 600;
  }

  .reviews__title span {
    color: var(--c-lime);
  }

  .reviews__badges {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-sm);
  }

  .reviews__badges li {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 1rem;
    border-radius: var(--radius-md);
    background: rgb(12 13 18 / 0.25);
    font-weight: 600;
    font-size: var(--fs-sm);
  }

  .reviews__badges :global(.icon) {
    color: var(--c-lime);
  }

  .reviews__row {
    overflow: hidden;
  }

  .reviews__row + .reviews__row {
    margin-top: var(--space-sm);
  }

  .reviews__track {
    --gap: var(--space-sm);
    display: flex;
    gap: var(--gap);
    width: max-content;
    animation: reviews-scroll 70s linear infinite;
  }

  .reviews__row--reverse .reviews__track {
    animation-direction: reverse;
    animation-duration: 80s;
  }

  .reviews__row:hover .reviews__track,
  .reviews__row:focus-within .reviews__track {
    animation-play-state: paused;
  }

  @keyframes reviews-scroll {
    to {
      transform: translateX(calc(-50% - var(--gap) / 2));
    }
  }

  .review {
    flex-shrink: 0;
    width: clamp(260px, 26vw, 360px);
  }

  .review figure {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    height: 100%;
    min-height: 240px;
    padding: var(--space-lg);
    border-radius: var(--radius-lg);
    background: #eef6ff;
    color: var(--c-ink);
  }

  .review:nth-child(3n + 2) figure {
    background: #f4fcd6;
  }

  .review__stars {
    color: var(--c-ink);
    letter-spacing: 0.15em;
  }

  .review__quote {
    flex: 1;
    font-size: var(--fs-lg);
    line-height: 1.45;
  }

  .review__author {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }

  .review__author > span {
    display: grid;
    font-size: var(--fs-sm);
  }

  .review :global(.review__avatar) {
    flex-shrink: 0;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: var(--radius-sm);
    object-fit: cover;
  }

  .review__avatar--initials {
    display: grid;
    place-items: center;
    background: var(--c-ink);
    color: var(--c-lime);
    font-family: var(--font-mono);
    font-weight: 700;
  }

  .review__detail {
    color: var(--c-muted);
  }

  .review__detail a {
    text-decoration: underline;
  }

  .reviews__note {
    margin-top: var(--space-lg);
    font-size: var(--fs-xs);
    text-align: center;
    color: rgb(255 255 255 / 0.75);
  }

  @media (prefers-reduced-motion: reduce) {
    .reviews__row {
      overflow-x: auto;
    }

    .reviews__track {
      animation: none;
      padding-inline: var(--gutter);
    }

    .review[aria-hidden='true'] {
      display: none;
    }
  }
</style>
