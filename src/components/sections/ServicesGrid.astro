---
import { Image } from 'astro:assets';
import friendsAtTable from '@/assets/illustrations/friends-at-table.png';
import Icon from '@/components/ui/Icon.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import UnsplashImage from '@/components/ui/UnsplashImage.astro';
import { services } from '@/data/services';
---

<section class="services section" aria-labelledby="services-title">
  <div class="container">
    <div class="services__head">
      <SectionHeading
        eyebrow="What we do"
        title="Everything it takes to <em>pack the room</em>"
        lead="Four focused services, one obsession: more guests through your doors and more revenue on every night of the week."
      />
      <Image
        src={friendsAtTable}
        alt=""
        widths={[240, 360, 480, 640]}
        sizes="(max-width: 760px) 240px, 340px"
        format="webp"
        quality={80}
        class="services__art"
      />
    </div>

    <ul role="list" class="services__grid">
      {
        services.map((service, i) => (
          <li class:list={['service-card', `accent-${service.accent}`]} data-reveal style={`--reveal-delay:${i * 0.08}s`}>
            <a href={`/services/#${service.slug}`} class="service-card__link">
              <div class="service-card__media">
                <UnsplashImage
                  image={service.image}
                  width={600}
                  height={420}
                  sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 25vw"
                />
              </div>
              <div class="service-card__body">
                <span class="service-card__index">0{i + 1}</span>
                <h3 class="service-card__title">{service.title}</h3>
                <p>{service.summary}</p>
                <span class="service-card__arrow" aria-hidden="true">
                  <Icon name="arrow-up-right" />
                </span>
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .services__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-xl);
  }

  .services__head :global(.services__art) {
    flex-shrink: 0;
    width: clamp(220px, 26vw, 340px);
    height: auto;
    margin-bottom: var(--space-lg);
    filter: drop-shadow(0 16px 20px rgb(12 13 18 / 0.15));
  }

  @media (max-width: 760px) {
    .services__head {
      flex-direction: column-reverse;
      align-items: center;
      text-align: center;
    }

    .services__head :global(.services__art) {
      margin-bottom: 0;
    }

    .services__head :global(.section-heading) {
      justify-items: center;
    }
  }

  .services__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-md);
  }

  .service-card {
    --accent: var(--c-sky);
    --on-accent: var(--c-paper);
    border-radius: var(--radius-lg);
    background: var(--accent);
    color: var(--on-accent);
    overflow: hidden;
    transition: transform 0.35s var(--ease-out);
  }

  .service-card:hover {
    transform: translateY(-6px) rotate(-0.6deg);
  }

  .accent-sky {
    --accent: var(--c-sky);
  }
  .accent-tomato {
    --accent: var(--c-tomato);
  }
  .accent-lime {
    --accent: var(--c-lime);
    --on-accent: var(--c-ink);
  }
  .accent-pink {
    --accent: var(--c-pink);
    --on-accent: var(--c-ink);
  }

  .service-card__link {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .service-card__media {
    margin: 0.5rem 0.5rem 0;
    border-radius: calc(var(--radius-lg) - 0.5rem);
    overflow: hidden;
    aspect-ratio: 10 / 7;
  }

  .service-card__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease-out);
  }

  .service-card:hover .service-card__media :global(img) {
    transform: scale(1.06);
  }

  .service-card__body {
    position: relative;
    display: grid;
    gap: var(--space-xs);
    padding: var(--space-lg);
    padding-bottom: calc(var(--space-lg) + 2.5rem);
    flex: 1;
    font-size: var(--fs-sm);
  }

  .service-card__index {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    opacity: 0.75;
  }

  .service-card__title {
    font-size: var(--fs-xl);
  }

  .service-card__arrow {
    position: absolute;
    right: var(--space-lg);
    bottom: var(--space-lg);
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    background: var(--c-ink);
    color: var(--c-lime);
    transition: transform 0.3s var(--ease-out);
  }

  .service-card:hover .service-card__arrow {
    transform: rotate(45deg);
  }

  @media (max-width: 1024px) {
    .services__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 560px) {
    .services__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
