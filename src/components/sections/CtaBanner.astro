---
import Button from '@/components/ui/Button.astro';
import UnsplashImage from '@/components/ui/UnsplashImage.astro';
import { site } from '@/config/site';
import { images } from '@/data/images';

export interface Props {
  title?: string;
  text?: string;
}

const {
  title = 'Ready to see every seat filled?',
  text = 'Let’s boost your bookings and bring more guests through your doors. Start with a free, no-strings marketing audit.',
} = Astro.props;
---

<section class="cta section" aria-labelledby="cta-title">
  <div class="container">
    <div class="cta__box" data-reveal>
      <div class="cta__copy">
        <p class="eyebrow">Get started</p>
        <h2 id="cta-title" class="cta__title">{title}</h2>
        <p>{text}</p>
        <div class="cta__actions">
          <Button href="/contact/" variant="ink" withArrow>Book your free audit</Button>
          <Button href={`mailto:${site.contact.email}`} variant="outline">Email us</Button>
        </div>
        <p class="cta__email">
          Or write to <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a>
        </p>
      </div>
      <div class="cta__photos" aria-hidden="true">
        <UnsplashImage image={images.pizza} width={320} height={400} sizes="200px" widths={[320, 640]} alt="" />
        <UnsplashImage image={images.steakFrites} width={320} height={400} sizes="200px" widths={[320, 640]} alt="" />
      </div>
    </div>
  </div>
</section>

<style>
  .cta__box {
    position: relative;
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: var(--space-xl);
    align-items: center;
    padding: clamp(2rem, 5vw, 4rem);
    border-radius: var(--radius-xl);
    background:
      radial-gradient(circle at 90% 10%, var(--c-sun), transparent 40%),
      var(--c-tomato);
    overflow: hidden;
  }

  .cta__copy {
    display: grid;
    gap: var(--space-md);
    justify-items: start;
  }

  .cta__title {
    font-size: var(--fs-3xl);
    max-width: 14ch;
  }

  .cta__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-top: var(--space-sm);
  }

  .cta__email {
    font-size: var(--fs-sm);
  }

  .cta__email a {
    font-weight: 700;
    text-decoration: underline;
  }

  .cta__photos {
    position: relative;
    height: 100%;
    min-height: 280px;
  }

  .cta__photos :global(img) {
    position: absolute;
    width: 55%;
    border-radius: var(--radius-lg);
    border: 6px solid var(--c-paper);
    box-shadow: var(--shadow-md);
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }

  .cta__photos :global(img:first-child) {
    left: 5%;
    top: 0;
    rotate: -8deg;
  }

  .cta__photos :global(img:last-child) {
    right: 5%;
    bottom: 0;
    rotate: 7deg;
  }

  @media (max-width: 860px) {
    .cta__box {
      grid-template-columns: 1fr;
    }
  }
</style>
