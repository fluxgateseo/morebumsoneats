---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/sections/PageHero.astro';
import Button from '@/components/ui/Button.astro';
import celebratingOnStool from '@/assets/illustrations/celebrating-on-stool.png';
---

<BaseLayout title="Page Not Found" description="Sorry, we couldn’t find that page." noindex>
  <PageHero
    eyebrow="404"
    title="This table’s <span>not available</span>"
    lead="The page you’re looking for has moved or never existed. Let’s get you seated somewhere better."
    illustration={celebratingOnStool}
  >
    <Button href="/" withArrow>Back to home</Button>
  </PageHero>
</BaseLayout>
