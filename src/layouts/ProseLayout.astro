---
/** Simple long-form text layout for legal and utility pages. */
import BaseLayout, { type Props as BaseProps } from './BaseLayout.astro';
import PageHero from '@/components/sections/PageHero.astro';

export interface Props extends BaseProps {
  heading: string;
  eyebrow: string;
  lead?: string;
}

const { heading, eyebrow, lead, ...seo } = Astro.props;
---

<BaseLayout {...seo}>
  <PageHero eyebrow={eyebrow} title={heading} lead={lead} tone="pink" />
  <section class="section">
    <div class="container prose">
      <slot />
    </div>
  </section>
</BaseLayout>

<style>
  .prose {
    max-width: 72ch;
  }

  .prose :global(h2) {
    margin-top: var(--space-xl);
    margin-bottom: var(--space-sm);
    font-size: var(--fs-2xl);
  }

  .prose :global(p),
  .prose :global(ul) {
    margin-bottom: var(--space-md);
    color: var(--c-ink-soft);
  }

  .prose :global(ul) {
    padding-left: 1.25rem;
  }

  .prose :global(a) {
    color: var(--c-sky);
    text-decoration: underline;
  }
</style>
